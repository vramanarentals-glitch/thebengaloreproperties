# Optional: Configure EmailJS to send real OTP emails directly to user's Gmail inbox
VITE_EMAILJS_SERVICE_ID=service_gmail_otp
VITE_EMAILJS_TEMPLATE_ID=template_otp_code
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Optional: Configure Google Cloud Client ID for real Google Account OAuth Sign-In
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
